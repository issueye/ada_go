{
  "t": "section",
  "p": { "class": "iso-card", "data-kind": "parity" },
  "c": [
    {
      "t": "div",
      "p": { "class": "iso-card__head" },
      "c": [
        {
          "t": "h2",
          "p": { "class": "iso-card__title" },
          "c": [{ "t": "#text", "v": "同构卡片" }]
        },
        {
          "t": "span",
          "p": { "class": "iso-chip", "data-tone": "brand" },
          "c": [{ "t": "#text", "v": "2/3" }]
        }
      ]
    },
    {
      "t": "p",
      "p": { "class": "iso-card__body" },
      "c": [{ "t": "#text", "v": "服务端与客户端必须输出同一棵树。" }]
    },
    {
      "t": "div",
      "p": { "class": "iso-card__foot" },
      "c": [
        {
          "t": "button",
          "p": { "class": "ada-btn ada-btn--primary", "type": "button" },
          "c": [{ "t": "#text", "v": "开始" }]
        },
        {
          "t": "button",
          "p": { "class": "ada-btn", "type": "button", "disabled": true },
          "c": [{ "t": "#text", "v": "不可用" }]
        }
      ]
    }
  ]
