{{define "head"}}<!doctype html>
<html lang="{{.Locale}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{{if .RefreshSeconds}}<meta http-equiv="refresh" content="{{.RefreshSeconds}}">{{end}}
<title>{{.Title}} · {{.ProductName}}</title>
<!--
  样式加载顺序固定为：设计令牌 → a_da 产物 → a_da 组件层 → ada-go 本地覆盖。
  app-local.css 最后加载，承接无 JS 表单与实时流的本地细节。
-->
<link rel="stylesheet" href="/static/tokens.css">
<link rel="stylesheet" href="/static/app.css">
<link rel="stylesheet" href="/static/ui/components.css">
<link rel="stylesheet" href="/static/ui/layout.css">
<link rel="stylesheet" href="/static/ui/widgets.css">
<link rel="stylesheet" href="/static/ui/shell.css">
<link rel="stylesheet" href="/static/ui/pages.css">
<link rel="stylesheet" href="/static/app-local.css">
</head>
<body class="ada-body">
<a class="skip-link" href="#main">跳到主要内容</a>
{{.Icons}}
<div class="ada-shell">
  <aside class="ada-sidebar" id="chat-sidebar" aria-label="侧栏">
    <div class="ada-side">
      <a class="brand" href="/" aria-label="返回会话">
        <span class="ada-brand">
          <span class="ada-brand__mark" aria-hidden="true">A</span>
          <span class="ada-brand__name">{{.ProductName}}</span>
          <span class="ada-brand__badge">SSR</span>
        </span>
      </a>
      {{slot "sidebar.top" .Slots.SidebarTop 0 ""}}
      <nav class="ada-nav" aria-label="主导航">
        <a class="ada-nav__item" href="/"><span class="ada-nav__text">会话</span></a>
        <a class="ada-nav__item" href="/threads"><span class="ada-nav__text">全部会话</span></a>
      </nav>
      {{slot "sidebar.bottom" .Slots.SidebarBottom 0 ""}}
      <div class="ada-sidebar__foot">
        {{if .ShowWorkspacePicker}}
        <form class="workspace-picker" method="post" action="/workspace">
          {{template "csrf" .}}
          <select name="index" aria-label="工作区">
            {{range .Workspaces}}<option value="{{.Index}}"{{if eq .Index $.WorkspaceIndex}} selected{{end}}>{{.Name}} — {{.Path}}</option>{{end}}
          </select>
          <button type="submit" class="btn-quiet">切换</button>
        </form>
        {{end}}
        <div class="ada-sidebar__meta">
          {{with .Identity}}<span class="identity">{{.}}</span>{{end}}
          <a href="{{.LoginPath}}">登录</a>
        </div>
      </div>
    </div>
  </aside>
  <div class="ada-backdrop" id="chat-backdrop" aria-hidden="true"></div>

  <main id="main" class="ada-main">
    <header class="ada-topbar">
      <div class="ada-topbar__title">
        <h1>{{.Title}}</h1>
        <span class="ada-chip">{{.ProductName}}</span>
      </div>
      <div class="ada-topbar__actions">
        {{slot "topbar.right" .Slots.TopbarRight 0 ""}}
      </div>
    </header>
{{end}}

{{define "foot"}}
  </main>
</div>
</body>
</html>
{{end}}

{{define "csrf"}}{{with .CSRF}}<input type="hidden" name="csrf_token" value="{{.}}">{{end}}{{end}}

{{define "parts"}}{{range .Parts}}{{if eq .Type "thinking"}}<details class="thinking ada-disclosure" data-kind="thinking"><summary class="ada-disclosure__summary"><span class="ada-disclosure__label">思考过程</span></summary><div class="ada-disclosure__rail"><div class="part-text">{{.Text}}</div></div></details>{{else if eq .Type "image"}}<span class="part-image">[图片]</span>{{else}}<div class="part-text">{{.Text}}</div>{{end}}{{end}}{{end}}

{{define "entry"}}
{{if eq .Kind "user"}}
<article class="ada-msg ada-msg--user">
  <div class="ada-bubble">{{template "parts" .}}</div>
</article>
{{else if eq .Kind "assistant"}}
<article class="ada-msg ada-msg--assistant">
  <span class="ada-avatar" aria-hidden="true">A</span>
  <div class="ada-msg__body">{{template "parts" .}}</div>
</article>
{{else if eq .Kind "tool"}}
<details class="ada-disclosure" data-kind="tool" data-state="closed" data-tool-state="{{.Tool.Status}}">
  <summary class="ada-disclosure__summary">
    <span class="ada-disclosure__label"><code class="tool-name">{{.Tool.Tool}}</code></span>
    <span class="ada-disclosure__detail tool-id">{{.Tool.CallID}}</span>
    <span class="ada-badge">{{.Tool.StatusLabel}}</span>
    <span class="ada-disclosure__meta">{{.Tool.DurationMS}} ms</span>
    {{if .Tool.Truncated}}<span class="ada-badge ada-badge--warn">已截断</span>{{end}}
  </summary>
  <div class="ada-disclosure__rail">
    {{with .Tool.Reason}}<p class="muted">原因：{{.}}</p>{{end}}
    {{with .Tool.Output}}<div class="ada-panel ada-tool-output" data-expanded="true" data-body="text"><div class="ada-panel__body"><pre class="ada-tool-output__full">{{.}}</pre></div></div>{{end}}
    {{with .Tool.Details}}<details class="ada-disclosure tool-details" data-kind="tool-details"><summary class="ada-disclosure__summary"><span class="ada-disclosure__label">详情</span></summary><div class="ada-disclosure__rail"><pre>{{.}}</pre></div></details>{{end}}
  </div>
</details>
{{else if eq .Kind "notice"}}
<div class="ada-notice {{if eq .Level "error"}}ada-notice--danger{{else if eq .Level "warn"}}ada-notice--warn{{else}}ada-notice--info{{end}}"><div class="ada-notice__row"><span>{{.Text}}</span></div></div>
{{else}}
<div class="ada-notice ada-notice--info"><div class="ada-notice__row"><span>{{.Text}}</span></div></div>
{{end}}
{{end}}

{{define "interaction"}}
<article class="interaction" data-kind="{{.Kind}}">
  <h3>{{.Title}}</h3>
  {{with .Body}}<p class="interaction-body">{{.}}</p>{{end}}
  <form method="post" action="{{.Action}}">
    {{template "csrf" .}}
    <input type="hidden" name="kind" value="{{.Kind}}">
    {{if eq .Kind "select"}}
    <label class="field">选择
      <select name="value">{{range .Options}}<option value="{{.}}">{{.}}</option>{{end}}</select>
    </label>
    {{else if eq .Kind "input"}}
    <label class="field">回答
      <input type="text" name="value" autocomplete="off">
    </label>
    {{end}}
    <div class="actions">
      {{if eq .Kind "confirm"}}
      <button type="submit" name="decision" value="deny" class="btn-safe" autofocus>拒绝</button>
      <button type="submit" name="decision" value="accept" class="btn-primary">接受</button>
      {{else}}
      <button type="submit" name="decision" value="accept" class="btn-primary">提交</button>
      <button type="submit" name="decision" value="deny" class="btn-safe">拒绝</button>
      {{end}}
      <button type="submit" name="decision" value="cancel" class="btn-quiet">取消</button>
    </div>
  </form>
</article>
{{end}}
