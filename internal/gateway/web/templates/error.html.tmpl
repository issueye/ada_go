{{define "error"}}{{template "head" .}}
<div class="ada-scroll">
<div class="ada-wrap">
<div class="page">
<section class="panel error-panel">
  <p class="error-status">HTTP {{.Status}}</p>
  <h1>{{.Heading}}</h1>
  <p>{{.Message}}</p>
  {{with .Detail}}<p class="error-detail">技术细节：{{.}}</p>{{end}}
  <p class="actions">
    <a class="btn btn-primary" href="{{.RetryPath}}">{{.RetryLabel}}</a>
    <a class="btn btn-quiet" href="/">返回会话列表</a>
  </p>
</section>
</div>
</div>
</div>
{{template "foot" .}}{{end}}
