{{define "chat"}}{{template "doc_head" .}}{{template "shell_start" .}}
  <div class="ada-corner-dock" id="chat-corner" aria-label="会话状态卡">{{slot "chat.corner" .Slots.ChatCorner .SlotCounts.ChatCorner ""}}</div>

  {{template "flash" .}}

  <div class="ada-chat-viewport">
    <div class="ada-scroll" id="chat-scroll">
      <div class="ada-wrap{{if not .Thread.ID}} ada-wrap--newtask{{end}}">
        {{if not .Connected}}
        <div class="ada-empty">
          <span class="ada-empty__mark">{{icon "i-alert" 20}}</span>
          <h2 class="ada-empty__title">暂时没有连上 agent</h2>
          <p class="ada-empty__desc">请确认桌面端或网关仍在运行，然后重新连接。已加载的页面不会伪造会话数据。</p>
          <div class="ada-empty__action"><a class="ada-btn ada-btn--primary ada-btn--md" href="">重新连接</a></div>
        </div>
        {{else if .Thread.ID}}
        <div id="transcript-island"{{if .Transcript}} data-ada-island="transcript" data-ada-state="{{.TranscriptStateJSON}}"{{end}}>
        <div id="transcript" class="ada-transcript" data-thread-id="{{.Thread.ID}}" data-run-status="{{.Run.Status}}">
          {{if .HasOlder}}<a class="ada-history-more" href="{{.OlderHref}}">加载更早消息</a>{{end}}
          {{if .Transcript}}{{range .Transcript}}{{template "row" .}}{{end}}{{else}}
          <div class="ada-empty">
            <span class="ada-empty__mark">{{icon "i-chat" 20}}</span>
            <h2 class="ada-empty__title">这个会话还没有消息</h2>
            <p class="ada-empty__desc">在下方输入内容并发送，agent 的回复会出现在这里。</p>
          </div>
          {{end}}
          <div id="live-stream" class="live-stream" aria-live="polite" aria-label="实时输出" hidden></div>
        </div>
        </div>
        {{slot "transcript.after" .Slots.TranscriptAfter .SlotCounts.TranscriptAfter ""}}
        <div id="live-status" class="live-status" role="status" aria-live="polite" hidden></div>
        {{if .Run.ErrorLabel}}
        <div class="ada-run-error" role="alert">
          <span class="ada-run-error__icon">{{icon "i-alert" 16}}</span>
          <div class="ada-run-error__body">
            <strong class="ada-run-error__title">{{if eq .Run.Terminal "error"}}本轮失败{{else if eq .Run.Terminal "interrupted"}}本轮已中断{{else}}本轮未完成{{end}}</strong>
            <p class="ada-run-error__detail">{{.Run.ErrorLabel}}</p>
            {{if .Run.ErrorDetail}}<p class="ada-run-error__reason">{{.Run.ErrorDetail}}</p>{{end}}
            {{if .Run.ErrorCode}}<span class="ada-run-error__code">错误码 {{.Run.ErrorCode}}</span>{{end}}
          </div>
        </div>
        {{end}}
        {{else}}
        <div class="ada-newtask">
          <div class="ada-newtask__inner">
            <span class="ada-newtask__mark"><img src="{{asset "logo.png"}}" alt="" width="40" height="40" decoding="async"></span>
            <h2 class="ada-newtask__greeting">{{.Greeting}}</h2>
            <p class="ada-newtask__desc">描述你要完成的任务，agent 会在选定的工作区里开始工作。</p>
            <form class="ada-newtask__form" method="post" action="/threads" data-new-task enctype="multipart/form-data">
              {{template "csrf" .}}
              <div class="ada-composer__card ada-newtask__card">
                <div class="ada-composer__thumbs" data-image-thumbs hidden></div>
                <textarea class="ada-composer__input" name="text" rows="2" maxlength="65536" data-draft-key="new-task" placeholder="向 {{.ProductName}} 提问，或描述一个任务…" aria-label="任务描述"></textarea>
                <input class="ada-composer__image-input" id="ada-image-input-new" type="file" name="images" multiple accept="image/png,image/jpeg,image/webp,image/gif" aria-hidden="true" tabindex="-1">
                <div class="ada-composer__bar">
                  <div class="ada-composer__group ada-composer__group--left">
                    <label class="ada-composer__attach" for="ada-image-input-new" title="添加图片" aria-label="添加图片">{{icon "i-image" 14}}</label>
                    <div class="ada-newtask__ws-controls" data-workspace-controls hidden>
                      <button class="ada-tool ada-tool--workspace" type="button" data-file-picker-open title="选择工作区：{{.Workspace}}">
                        {{icon "i-folder" 14}}<span class="ada-tool__label" data-workspace-label>{{.WorkspaceName}}</span>{{icon "i-chevron-down" 12}}
                      </button>
                    </div>
                    <select class="ada-input ada-newtask__ws-native" name="workspace" data-workspace-native aria-label="工作区">
                      {{range .Workspaces}}<option value="{{.Path}}"{{if eq .Path $.Workspace}} selected{{end}}>{{.Name}} — {{.Path}}</option>{{end}}
                    </select>
                    <input type="hidden" data-workspace-input value="{{.Workspace}}">
                    {{if .Models}}
                    <ada-select class="ada-select ada-model-picker" data-model-picker>
                      <button class="ada-select__trigger ada-model-picker__trigger" type="button" data-select-trigger aria-expanded="false" title="选择当前模型">
                        <span class="ada-model-picker__icon">{{icon "i-sparkles" 14}}</span>
                        <span class="ada-select__label ada-model-picker__label" data-select-label>{{.CurrentModelLabel}}</span>
                        <span class="ada-select__caret">{{icon "i-chevron-down" 12}}</span>
                      </button>
                      <div class="ada-select__menu ada-model-picker__menu" data-select-menu hidden>
                        <p class="ada-model-picker__group">模型</p>
                        {{range .Models}}<button class="ada-select__option ada-model-picker__option{{if .Current}} is-selected{{end}}" type="button" data-value="{{.ProviderID}}|{{.ModelID}}" data-label="{{.ShortLabel}}" data-levels="{{.ThinkingLevelsCSV}}" data-current-level="{{if .Current}}{{$.CurrentModelLevel}}{{end}}" aria-selected="{{if .Current}}true{{else}}false{{end}}">
                          <span class="ada-model-picker__name">{{.Label}}</span>
                          <span class="ada-model-picker__provider">{{.ProviderID}}</span>
                          {{if .ThinkingLevels}}<span class="ada-model-picker__chevron">{{icon "i-chevron" 12}}</span>{{end}}
                        </button>
                        {{end}}
                      </div>
                      <input type="hidden" data-select-input value="{{.CurrentModelValue}}">
                      <noscript><select class="ada-input ada-select__fallback" name="model" aria-label="选择当前模型">{{range .Models}}<option value="{{.ProviderID}}|{{.ModelID}}"{{if .Current}} selected{{end}}>{{.Label}}</option>{{end}}</select></noscript>
                    </ada-select>
                    {{end}}
                    {{slot "composer.left" .Slots.ComposerLeft .SlotCounts.ComposerLeft ""}}
                  </div>
                  <div class="ada-composer__group ada-composer__group--right">
                    {{slot "composer.right" .Slots.ComposerRight .SlotCounts.ComposerRight ""}}
                    <button class="ada-send" type="submit" aria-label="开始任务" title="开始任务">{{icon "i-send" 14}}</button>
                  </div>
                </div>
              </div>
            </form>
          </div>
        </div>
        {{end}}
      </div>
      <button class="ada-scroll-bottom" id="scroll-bottom" type="button" data-ada-scroll-bottom hidden title="回到最新">
        <svg class="ada-icon" width="13" height="13" aria-hidden="true"><use href="#i-chevron-down"></use></svg>
        <span>回到最新</span>
      </button>
    </div>

    <div class="ada-float-dock" id="composer-above" aria-label="插件悬浮区">{{slot "composer.above" .Slots.ComposerAbove .SlotCounts.ComposerAbove ""}}</div>
    <div class="ada-run-status-dock" id="run-status">{{if or .Run.Active (eq .Run.Status "waiting_input")}}<span class="ada-run-status" data-run-state="{{.Run.Status}}" data-run-started-at="{{.Run.StartedAt}}" role="status" aria-live="polite" aria-label="{{.Run.Label}}"><span class="ada-run-status__mark" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><rect x="3.6" y="9" width="2.4" height="6" rx="1.2"/><rect x="8.4" y="5" width="2.4" height="14" rx="1.2"/><rect x="13.2" y="7" width="2.4" height="10" rx="1.2"/><rect x="18" y="10" width="2.4" height="4" rx="1.2"/></svg></span><span class="ada-run-status__text" aria-hidden="true"><span data-run-label>{{if eq .Run.Status "waiting_input"}}等待你的答复{{else if eq .Run.Status "finishing"}}正在收尾{{else}}深度求索中{{end}}</span><span class="ada-run-status__sep">，</span><span>用时 <span data-run-elapsed>— 秒</span></span><span class="ada-run-status__dots"><span>.</span><span>.</span><span>.</span></span></span></span>{{end}}</div>
  </div>

  <div class="ada-trays" id="ada-trays" role="region" aria-live="polite" aria-label="待处理事项">
    {{slot "thread.tray" .Slots.ThreadTray .SlotCounts.ThreadTray ""}}
    {{if and .Interactions (eq .SlotCounts.ThreadTray 0)}}{{template "interactions" .Interactions}}{{end}}
  </div>

  {{if .Thread.ID}}
  <form class="ada-composer" method="post" action="/threads/{{.Thread.ID}}/send" data-thread-id="{{.Thread.ID}}" enctype="multipart/form-data">
    {{template "csrf" .}}
    <div class="ada-outbox" data-outbox role="region" aria-live="polite" aria-label="待发送消息" hidden></div>
    <div class="ada-composer__card">
      {{/* 缩略图位置与新建任务页保持一致：始终在输入框上方。 */}}
      <div class="ada-composer__thumbs" data-image-thumbs hidden></div>
      <textarea class="ada-composer__input" name="text" rows="2" maxlength="65536" data-draft-key="thread:{{.Thread.ID}}" placeholder="向 {{.ProductName}} 提问，或指派一个任务…" aria-label="消息输入框" required></textarea>
      <div class="ada-composer__bar">
        <div class="ada-composer__group ada-composer__group--left">
          <input class="ada-composer__image-input" id="ada-image-input-{{.Thread.ID}}" type="file" name="images" multiple accept="image/png,image/jpeg,image/webp,image/gif" aria-hidden="true" tabindex="-1">
          <label class="ada-composer__attach" for="ada-image-input-{{.Thread.ID}}" title="添加图片" aria-label="添加图片">{{icon "i-image" 14}}</label>
          <details class="ada-plus">
            <summary class="ada-plus__button" title="更多操作" aria-label="更多操作">{{icon "i-plus" 14}}</summary>
            <div class="ada-plus__panel">
              <a class="ada-plus__item" href="/">{{icon "i-plus" 14}}<span>新建任务</span></a>
            </div>
          </details>
          <span class="ada-tool ada-tool--workspace" title="{{.Workspace}}">{{icon "i-git-branch" 14}}<span class="ada-tool__label">{{.WorkspaceName}}</span></span>
          {{if .Models}}
          <ada-select class="ada-select ada-model-picker" data-model-picker>
            <button class="ada-select__trigger ada-model-picker__trigger" type="button" data-select-trigger aria-expanded="false" title="选择当前模型">
              <span class="ada-model-picker__icon">{{icon "i-sparkles" 14}}</span>
              <span class="ada-select__label ada-model-picker__label" data-select-label>{{.CurrentModelLabel}}</span>
              <span class="ada-select__caret">{{icon "i-chevron-down" 12}}</span>
            </button>
            <div class="ada-select__menu ada-model-picker__menu" data-select-menu hidden>
              <p class="ada-model-picker__group">模型</p>
              {{range .Models}}<button class="ada-select__option ada-model-picker__option{{if .Current}} is-selected{{end}}" type="button" data-value="{{.ProviderID}}|{{.ModelID}}" data-label="{{.ShortLabel}}" data-levels="{{.ThinkingLevelsCSV}}" data-current-level="{{if .Current}}{{$.CurrentModelLevel}}{{end}}" aria-selected="{{if .Current}}true{{else}}false{{end}}">
                <span class="ada-model-picker__name">{{.Label}}</span>
                <span class="ada-model-picker__provider">{{.ProviderID}}</span>
                {{if .ThinkingLevels}}<span class="ada-model-picker__chevron">{{icon "i-chevron" 12}}</span>{{end}}
              </button>
              {{end}}
            </div>
            <input type="hidden" data-select-input value="{{.CurrentModelValue}}">
            <noscript><select class="ada-input ada-select__fallback" name="model" aria-label="选择当前模型">{{range .Models}}<option value="{{.ProviderID}}|{{.ModelID}}"{{if .Current}} selected{{end}}>{{.Label}}</option>{{end}}</select></noscript>
          </ada-select>
          {{end}}
          {{slot "composer.left" .Slots.ComposerLeft .SlotCounts.ComposerLeft ""}}
        </div>
        <div class="ada-composer__group ada-composer__group--right">
          {{slot "composer.right" .Slots.ComposerRight .SlotCounts.ComposerRight ""}}
          <button class="ada-send" type="submit" aria-label="{{if .Run.Active}}加入待发送队列{{else}}发送{{end}}" title="{{if .Run.Active}}加入待发送队列，可编辑或立即发送{{else}}发送（Enter）{{end}}">{{icon "i-send" 14}}</button>
        </div>
      </div>
    </div>
    {{/* 输入框下方辅助区整体交给插件岛（composer.footer + clientOnly）：
       基座不渲染任何内容，插件停用或脚本加载失败时这里保持空白。数据来自
       基座通用投影 GET /threads/{id}/state（run / context / usage）。
       宿主外壳不能包额外布局层：.ada-slot 与 .ada-island--client 都是
       display:contents，插件自己的 .ada-aux 直接落在 #composer-aux 里。 */}}
    <div id="composer-aux">{{slot "composer.footer" .Slots.ComposerFooter .SlotCounts.ComposerFooter ""}}</div>
    <input type="hidden" name="idempotencyKey" value="{{.TurnKey}}">
  </form>
  <script src="{{asset "chat-live.js"}}" defer></script>
  {{end}}
{{template "shell_end" .}}{{end}}

{{define "parts_user"}}{{range .Parts}}{{if eq .Type "thinking"}}{{template "thinking" .}}{{else if eq .Type "image"}}<button class="ada-msg__image" type="button" data-image-viewer aria-label="查看图片"><img loading="lazy" alt="图片" src="data:{{.Mime}};base64,{{.Data}}"></button>{{else}}<div class="part-text">{{.Text}}</div>{{end}}{{end}}{{end}}

{{define "parts_assistant"}}{{range .Parts}}{{if eq .Type "thinking"}}{{template "thinking" .}}{{else if eq .Type "image"}}<span class="ada-msg__images">[图片]</span>{{else}}<div class="part-text">{{if .HTML}}{{.HTML}}{{else}}{{markdown .Text}}{{end}}</div>{{end}}{{end}}{{end}}

{{define "thinking"}}
<details class="ada-disclosure" data-kind="thinking" data-state="closed">
  <summary class="ada-disclosure__summary">
    <span class="ada-disclosure__icon">{{icon "i-bulb" 14}}</span>
    <span class="ada-disclosure__caret">{{icon "i-chevron" 12}}</span>
    <span class="ada-disclosure__label">思考</span>
  </summary>
  <div class="ada-disclosure__rail"><div class="ada-thinking">{{.Text}}</div></div>
</details>
{{end}}

{{define "row"}}
{{if eq .Kind "user"}}
<div class="ada-msg ada-msg--user" data-item-key="{{.Key}}">
  <div class="ada-msg__group">
    <div class="ada-bubble">{{template "parts_user" .}}</div>
    {{if .CanEdit}}
    <details class="ada-msg__edit" data-msg-edit>
      <summary class="ada-msg__edit-trigger">编辑并重发</summary>
      <form class="ada-msg__edit-form" method="post" action="/threads/{{.ThreadID}}/resend">
        {{template "csrf" .}}
        <input type="hidden" name="entryId" value="{{.Key}}">
        <input type="hidden" name="idempotencyKey" value="{{.EditKey}}">
        <textarea class="ada-input ada-msg__edit-text" name="text" rows="3" maxlength="65536" required aria-label="编辑消息">{{.EditText}}</textarea>
        <p class="ada-msg__edit-hint">重新发送后，这条消息及其之后的所有对话会被舍弃；旧分支仍保留在存储里，不删除。原消息的图片会保留。</p>
        <div class="ada-msg__edit-actions">
          <a class="ada-btn ada-btn--secondary ada-btn--sm" href="/threads/{{.ThreadID}}">取消</a>
          <button class="ada-btn ada-btn--primary ada-btn--sm" type="submit">重新发送</button>
        </div>
      </form>
    </details>
    {{end}}
  </div>
</div>
{{else if eq .Kind "assistant"}}
<div class="ada-msg ada-msg--assistant" data-item-key="{{.Key}}"><span class="ada-avatar" title="助手">{{icon "i-bot" 14}}</span><div class="ada-msg__body markdown-body ada-markdown">{{template "parts_assistant" .}}</div></div>
{{else if eq .Kind "tool"}}
{{template "tool" .Tool}}
{{else if eq .Kind "notice"}}
<div class="ada-notice ada-notice--{{if eq .Level "error"}}danger{{else if eq .Level "warn"}}warn{{else}}brand{{end}}"><div class="ada-notice__row">{{icon "i-alert" 14}}<span>{{.Text}}</span></div></div>
{{else}}
<div class="ada-msg ada-msg--plain" data-item-key="{{.Key}}"><div class="ada-plain">{{.Text}}</div></div>
{{end}}
{{end}}

{{define "tool"}}
<details class="ada-disclosure" data-kind="tool" data-state="closed"{{if .CallID}} data-key="{{.CallID}}" data-item-key="tool:{{.CallID}}"{{end}}{{if eq .Status "error"}} data-phase="danger"{{else if eq .Status "denied"}} data-phase="warn"{{end}}>
  <summary class="ada-disclosure__summary">
    <span class="ada-disclosure__icon">{{icon (toolIcon .Tool) 14}}</span>
    <span class="ada-disclosure__caret">{{icon "i-chevron" 12}}</span>
    <span class="ada-disclosure__label">{{.Tool}}</span>
    {{if .ArgsHint}}<span class="ada-disclosure__detail ada-disclosure__detail--args" title="{{.ArgsHint}}">{{.ArgsHint}}</span>{{end}}
    {{if .StatusLabel}}<span class="ada-badge ada-badge--{{statusTone .Status}}">{{.StatusLabel}}</span>{{end}}
    {{if .DurationMS}}<span class="ada-disclosure__meta">{{.DurationMS}} ms</span>{{end}}
    {{if .Truncated}}<span class="ada-badge ada-badge--warn">已截断</span>{{end}}
  </summary>
  <div class="ada-disclosure__rail">
    {{with .Reason}}<p class="ada-notice__row">原因：{{.}}</p>{{end}}
    {{if .Output}}
    <div class="ada-panel ada-tool-output" data-expanded="shown" data-body="text">
      <div class="ada-panel__head">
        <span class="ada-panel__title">执行输出</span>
        <span class="ada-tool-output__meta">共 {{lineCount .Output}} 行</span>
        <button class="ada-panel__copy" type="button" data-copy="{{.Output}}" data-copy-label="复制">复制</button>
      </div>
      <div class="ada-panel__body ada-tool-output__scroll"><pre class="ada-tool-output__preview">{{.Output}}</pre></div>
    </div>
    {{end}}
    {{if .Args}}
    <div class="ada-panel">
      <div class="ada-panel__head"><span class="ada-panel__title">输入参数</span><button class="ada-panel__copy" type="button" data-copy="{{.Args}}" data-copy-label="复制">复制</button></div>
      <pre class="ada-panel__body">{{.Args}}</pre>
    </div>
    {{end}}
    {{if .Details}}
    <div class="ada-panel">
      <div class="ada-panel__head"><span class="ada-panel__title">详情</span><button class="ada-panel__copy" type="button" data-copy="{{.Details}}" data-copy-label="复制">复制</button></div>
      <pre class="ada-panel__body">{{.Details}}</pre>
    </div>
    {{end}}
    {{if and (not .Output) (not .Args) (not .Details)}}<div class="ada-panel"><div class="ada-panel__body ada-panel__body--html"><p>这个工具没有返回可展示的内容。</p></div></div>{{end}}
  </div>
</details>
{{end}}

{{define "interactions"}}
<div class="ada-tray ada-tray--approval" aria-label="待处理交互">
  <div class="ada-tray__head"><span class="ada-tray__icon">{{icon "i-alert" 14}}</span><span class="ada-tray__title">待答复 · {{len .}} 条</span></div>
  {{range .}}
  <div class="ada-tray__row{{if eq .Kind "form"}} ada-tray__row--form{{end}}">
    <div class="ada-tray__text">
      <strong>{{.Title}}</strong>{{if .Body}} — {{.Body}}{{end}}
    </div>
    {{if eq .Kind "form"}}
    {{template "ask-form" .}}
    {{else}}
    <form class="ada-tray__form" method="post" action="{{.Action}}">
      {{template "csrf" .}}
      <input type="hidden" name="kind" value="{{.Kind}}">
      {{if eq .Kind "select"}}{{if .Options}}{{$first := index .Options 0}}<ada-select class="ada-select ada-tray__select"><button class="ada-select__trigger" type="button" data-select-trigger aria-expanded="false" aria-label="选择"><span class="ada-select__label" data-select-label>{{$first}}</span><span class="ada-select__caret">{{icon "i-chevron-down" 12}}</span></button><div class="ada-select__menu" data-select-menu hidden>{{range .Options}}<button class="ada-select__option" type="button" data-value="{{.}}">{{.}}</button>{{end}}</div><input type="hidden" name="value" data-select-input value="{{$first}}" disabled><noscript><select class="ada-input ada-select__fallback" name="value" aria-label="选择">{{range .Options}}<option value="{{.}}">{{.}}</option>{{end}}</select></noscript></ada-select>{{end}}
      {{else if eq .Kind "input"}}<input class="ada-input" type="text" name="value" autocomplete="off" aria-label="回答">
      {{end}}
      {{if eq .Kind "confirm"}}
      <button class="ada-btn ada-btn--secondary ada-btn--sm" type="submit" name="decision" value="deny">拒绝</button>
      <button class="ada-btn ada-btn--primary ada-btn--sm" type="submit" name="decision" value="accept">接受</button>
      {{else}}
      <button class="ada-btn ada-btn--primary ada-btn--sm" type="submit" name="decision" value="accept">提交</button>
      <button class="ada-btn ada-btn--secondary ada-btn--sm" type="submit" name="decision" value="deny">拒绝</button>
      {{end}}
      <button class="ada-btn ada-btn--ghost ada-btn--sm" type="submit" name="decision" value="cancel">取消</button>
    </form>
    {{end}}
  </div>
  {{end}}
</div>
{{end}}

{{/* 多题分步表单：一题一步，「上一题/下一题/提交」。没有 JS 时所有题目同时展开、
     直接提交也能用（题目名 q0、q1…，基座按序拼成 answers）。 */}}
{{define "ask-form"}}
<form class="ada-tray__form ask-wizard" method="post" action="{{.Action}}" data-ask-form>
  {{template "csrf" .}}
  <input type="hidden" name="kind" value="form">
  <div class="ask-wizard__bar">
    <span class="ask-wizard__counter">第 <span data-ask-current>1</span> / {{len .Questions}} 题</span>
  </div>
  {{range .Questions}}
  <div class="ask-wizard__step" data-ask-step="{{.Index}}">
    <p class="ask-wizard__question">{{.Question}}</p>
    {{if eq .Kind "select"}}
      {{if .Options}}<ada-select class="ada-select ask-wizard__select"><button class="ada-select__trigger" type="button" data-select-trigger aria-expanded="false" aria-label="选择"><span class="ada-select__label" data-select-label>{{index .Options 0}}</span><span class="ada-select__caret">{{icon "i-chevron-down" 12}}</span></button><div class="ada-select__menu" data-select-menu hidden>{{range .Options}}<button class="ada-select__option" type="button" data-value="{{.}}">{{.}}</button>{{end}}</div><input type="hidden" name="q{{.Index}}" data-select-input value="{{index .Options 0}}" disabled><noscript><select class="ada-input ada-select__fallback" name="q{{.Index}}" aria-label="回答">{{range .Options}}<option value="{{.}}">{{.}}</option>{{end}}</select></noscript></ada-select>{{end}}
    {{else if eq .Kind "confirm"}}
      <div class="ask-wizard__choices">
        <label class="ask-wizard__choice"><input type="radio" name="q{{.Index}}" value="yes" checked><span>是</span></label>
        <label class="ask-wizard__choice"><input type="radio" name="q{{.Index}}" value="no"><span>否</span></label>
      </div>
    {{else}}
      <input class="ada-input ask-wizard__input" type="text" name="q{{.Index}}" autocomplete="off" aria-label="回答">
    {{end}}
  </div>
  {{end}}
  <div class="ask-wizard__nav">
    <button class="ada-btn ada-btn--secondary ada-btn--sm" type="button" data-ask-prev disabled>上一题</button>
    <button class="ada-btn ada-btn--secondary ada-btn--sm" type="button" data-ask-next>下一题</button>
    <button class="ada-btn ada-btn--primary ada-btn--sm" type="submit" name="decision" value="accept" data-ask-submit>提交</button>
    <button class="ada-btn ada-btn--ghost ada-btn--sm" type="submit" name="decision" value="cancel">取消</button>
  </div>
</form>
{{end}}
