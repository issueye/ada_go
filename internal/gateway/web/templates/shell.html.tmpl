{{/* SPA 外壳（R/S 阶段）：Go 只渲染 #app 与 bootstrap JSON 投影，页面由
     /static/ada/index.mjs 运行时装载。login/error 是仅存的无 JS 安全页，
     复用同一份 head（doc_head）。

     样式加载顺序固定为：设计令牌 → 衍生主题色板 → a_da 产物 → a_da 组件层 → ada-go 本地覆盖。
     themes.js/themes.css 是本地新增的主题扩展（明暗 × 调色板，docs/19-ued.md §19.2.2），
     不属于上游镜像；app-local.css 最后加载。 */}}
{{define "doc_head"}}<!doctype html>
<html lang="{{.Locale}}" class="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{{if .CSRF}}<meta name="csrf-token" content="{{.CSRF}}">{{end}}
<title>{{if .Title}}{{.Title}} · {{end}}{{.BrandName}}</title>
<link rel="icon" type="image/png" sizes="32x32" href="{{asset "favicon.png"}}">
<link rel="apple-touch-icon" sizes="180x180" href="{{asset "apple-touch-icon.png"}}">
<script src="{{asset "theme.js"}}"></script>
<script src="{{asset "themes.js"}}"></script>
<link rel="stylesheet" href="{{asset "tokens.css"}}">
<link rel="stylesheet" href="{{asset "ui/themes.css"}}">
<link rel="stylesheet" href="{{asset "app.css"}}">
<link rel="stylesheet" href="{{asset "ui/components.css"}}">
<link rel="stylesheet" href="{{asset "ui/layout.css"}}">
<link rel="stylesheet" href="{{asset "ui/widgets.css"}}">
<link rel="stylesheet" href="{{asset "ui/shell.css"}}">
<link rel="stylesheet" href="{{asset "ui/pages.css"}}">
<link rel="stylesheet" href="{{asset "ada/icons.css"}}">
<link rel="stylesheet" href="{{asset "ada/shell.css"}}">
<link rel="stylesheet" href="{{asset "app-local.css"}}">
<script src="{{asset "api.js"}}" defer></script>
<script src="{{asset "sidebar-boot.js"}}" defer></script>
<script src="{{asset "ada-select.js"}}" defer></script>
<script src="{{asset "ada-modal.js"}}" defer></script>
<script src="{{asset "file-picker.js"}}" defer></script>
<script src="{{asset "chat-images.js"}}" defer></script>
</head>
<body class="ada-body">
<a class="skip-link" href="#main">跳到主要内容</a>
{{end}}

{{define "shell_start"}}<main id="main" class="ada-main">
{{end}}

{{define "shell_end"}}
</main>
{{end}}

{{define "shell"}}{{template "doc_head" .}}
<div id="app"></div>
{{template "flash" .}}
<script type="application/json" id="ada-bootstrap">{{.BootstrapJSON}}</script>
<script type="module" src="{{asset "ada/index.mjs"}}"></script>
</body>
</html>
{{end}}

{{define "csrf"}}{{with .CSRF}}<input type="hidden" name="csrf_token" value="{{.}}">{{end}}{{end}}

{{define "flash"}}{{if .Flash}}{{.Flash}}{{end}}{{end}}
