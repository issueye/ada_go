{{define "overview"}}{{template "doc_head" .}}{{template "shell_start" .}}
  <div class="ada-scroll">
    <div class="ada-wrap" style="max-width:1040px">
      {{template "flash" .}}
      <div class="section-head">
        <div>
          <h1 class="page-title">概览</h1>
          <p class="page-sub">agent 状态、最近会话与插件贡献。</p>
        </div>
        <a class="btn btn-secondary btn-sm" href="/">去对话</a>
      </div>

      <div id="dashboard-live" hx-get="/partials/dashboard" hx-trigger="every 5s" hx-swap="innerHTML">
        {{template "overview_partial" .}}
      </div>
    </div>
  </div>
{{template "shell_end" .}}{{end}}

{{define "overview_partial"}}
<div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
  {{range .Stats}}
  <div class="card p-4">
    <span class="badge {{if eq .Tone "warn"}}badge-warn{{else if eq .Tone "brand"}}badge-brand{{else}}badge-neutral{{end}}">{{.Label}}</span>
    <p class="mt-3 text-2xl font-semibold tracking-tight text-ink">{{.Value}}</p>
    <p class="mt-1 text-xs leading-4 text-faint">{{.Hint}}</p>
  </div>
  {{end}}
</div>

<div class="card mt-4 overflow-hidden">
  <div class="section-head border-b border-line px-4 py-3">
    <div>
      <h2 class="section-title">最近会话</h2>
      <p class="section-sub">点击进入会话详情并发送消息</p>
    </div>
    <a class="link text-xs" href="/">全部会话</a>
  </div>
  {{if .Recent}}
  <div class="divide-y divide-line">
    {{range .Recent}}
    <a class="flex items-center gap-3 px-4 py-3 transition-colors hover:bg-subtle" href="/threads/{{.ID}}">
      <div class="min-w-0 flex-1">
        <div class="flex items-center gap-2">
          <span class="truncate text-xs font-medium text-ink">{{if .Title}}{{.Title}}{{else}}新会话{{end}}</span>
          {{if .Running}}<span class="badge badge-warn">运行中</span>{{end}}
        </div>
        <p class="mt-1 truncate text-xs text-faint">{{.Workspace}}</p>
      </div>
    </a>
    {{end}}
  </div>
  {{else}}
  <div class="px-4 py-8 text-center text-xs text-faint">还没有会话。去「对话」页新建一个。</div>
  {{end}}
</div>

<div class="mt-4">
  <div class="section-head">
    <div>
      <h2 class="section-title">插件贡献</h2>
      <p class="section-sub">来自插件的 dashboard 片段</p>
    </div>
    <a class="link text-xs" href="/extensions">管理扩展</a>
  </div>
  <div class="ada-slot-host">{{slot "dashboard.widgets" .Slots.DashboardWidgets .SlotCounts.DashboardWidgets ""}}</div>
</div>
{{end}}
