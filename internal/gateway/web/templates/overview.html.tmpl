{{define "overview"}}{{template "doc_head" .}}{{template "shell_start" .}}
  <div class="ada-scroll">
    <div class="ada-wrap ada-wrap--page">
      {{template "flash" .}}
      <div class="ov-head">
        <div class="ov-head__title">
          <h2 class="ada-page-title">概览</h2>
          <span class="ov-tip" data-tip="agent 状态、最近会话与插件贡献；统计来自本地会话、工作区与插件清单，插件贡献来自 dashboard 插槽。" tabindex="0" role="img">!</span>
        </div>
        <div class="ov-actions">
          <a class="ov-btn" href="/">新建任务</a>
          <a class="ov-btn ov-btn--primary" href="/">去对话</a>
        </div>
      </div>

      <div class="ov-grid">
        <div id="dashboard-live" class="ov-island" data-ada-island="overview" data-ada-state="{{.StateJSON}}">
          {{template "overview_partial" .}}
        </div>

        <section class="ov-contrib" aria-label="插件贡献">
          <div class="ov-contrib__head">
            <span class="ov-contrib__title">插件贡献</span>
            <span class="ov-tip ov-tip--sm" data-tip="插件通过 dashboard.widgets 插槽贡献的片段，随插件启停变化。" tabindex="0" role="img">!</span>
          </div>
          <p class="ov-contrib__desc">来自插件的 dashboard 片段</p>
          <div class="ov-contrib__slot">{{slot "dashboard.widgets" .Slots.DashboardWidgets .SlotCounts.DashboardWidgets ""}}</div>
          <a class="ov-contrib__more" href="/extensions">管理扩展 →</a>
        </section>
      </div>

      <div class="ov-status">
        <span class="ov-status__left"><span class="ov-status__dot"></span><span data-ov-status>服务已连接</span></span>
        <span class="ov-status__right">本地 · Headless</span>
      </div>
    </div>
  </div>
{{template "shell_end" .}}{{end}}

{{define "overview_partial"}}
<div class="ov-kpis">
  {{range .Stats}}
  <div class="ov-kpi" data-tone="{{.Tone}}">
    <span class="ov-kpi__label">{{.Label}}</span>
    <span class="ov-kpi__value{{if not .Numeric}} ov-kpi__value--text{{end}}">{{.Value}}</span>
    <span class="ov-kpi__note">{{.Hint}}</span>
  </div>
  {{end}}
</div>

<section class="ov-recent" aria-label="最近会话">
  <div class="ov-recent__head">
    <div class="ov-recent__title">
      <span>最近会话</span>
      <span class="ov-count">{{len .Recent}}</span>
    </div>
    <a class="ov-link" href="/">全部会话 →</a>
  </div>
  {{if .Recent}}
  <div class="ov-recent__list">
    {{range $i, $r := .Recent}}{{if lt $i 5}}
    <a class="ov-thread" href="/threads/{{$r.ID}}">
      <span class="ov-thread__main">
        <span class="ov-thread__title">{{if $r.Title}}{{$r.Title}}{{else}}新会话{{end}}{{if $r.Running}}<span class="ov-chip ov-chip--warn">运行中</span>{{end}}</span>
        <span class="ov-thread__path">{{$r.Workspace}}</span>
      </span>
      <span class="ov-thread__time">{{$r.UpdatedLabel}}</span>
    </a>
    {{end}}{{end}}
  </div>
  {{else}}
  <div class="ov-recent__empty">还没有会话。去「对话」页新建一个。</div>
  {{end}}
  <a class="ov-recent__more" href="/">查看全部会话 →</a>
</section>
{{end}}
