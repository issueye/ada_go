{{define "plugin_detail"}}{{template "doc_head" .}}{{template "shell_start" .}}
  <div class="ada-scroll">
    <div class="ada-wrap ada-wrap--page">
      {{template "flash" .}}
      <div class="section-head">
        <div>
          <h1 class="page-title">{{if .Plugin.Name}}{{.Plugin.Name}}{{else}}{{.Plugin.ID}}{{end}}</h1>
          <p class="page-sub">{{.Plugin.ID}}{{if .Plugin.Version}} · v{{.Plugin.Version}}{{end}}</p>
        </div>
        <a class="ada-btn ada-btn--secondary ada-btn--sm" href="/extensions">返回插件列表</a>
      </div>

      <div class="card p-4">
        <div class="flex flex-wrap items-center gap-2">
          {{if .Plugin.Frontend}}<span class="badge badge-brand">前端插件</span>{{end}}
          {{if .Plugin.Backend}}<span class="badge badge-neutral">后端插件</span>{{end}}
          <span class="badge badge-{{.Plugin.StatusTone}}">{{.Plugin.StatusLabel}}</span>
          {{if .Plugin.Status}}<span class="badge badge-neutral badge-mono">{{.Plugin.Status}}</span>{{end}}
        </div>

        {{if eq .Plugin.Status "unused"}}<p class="mt-2 text-xs text-muted">当前产品没有声明这个插件，因此未装配；随包保留，可在产品声明里启用。</p>{{end}}

        {{if .Plugin.Description}}<p class="mt-2 text-sm leading-6 text-muted">{{.Plugin.Description}}</p>{{end}}

        <dl class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {{if .Plugin.Source}}
          <div>
            <dt class="text-xs text-muted">来源</dt>
            <dd class="mt-1 text-sm text-ink">{{.Plugin.Source}}</dd>
          </div>
          {{end}}
          {{if .Plugin.Frontend}}
          <div>
            <dt class="text-xs text-muted">页面</dt>
            <dd class="mt-1 text-sm text-ink">{{.Plugin.Pages}}</dd>
          </div>
          <div>
            <dt class="text-xs text-muted">插槽</dt>
            <dd class="mt-1 text-sm text-ink">{{.Plugin.Slots}}</dd>
          </div>
          <div>
            <dt class="text-xs text-muted">导航</dt>
            <dd class="mt-1 text-sm text-ink">{{.Plugin.Nav}}</dd>
          </div>
          {{end}}
          {{if .Plugin.Backend}}
          <div>
            <dt class="text-xs text-muted">工具</dt>
            <dd class="mt-1 text-sm text-ink">{{.Plugin.Tools}}</dd>
          </div>
          <div>
            <dt class="text-xs text-muted">钩子</dt>
            <dd class="mt-1 text-sm text-ink">{{.Plugin.Hooks}}</dd>
          </div>
          <div>
            <dt class="text-xs text-muted">技能</dt>
            <dd class="mt-1 text-sm text-ink">{{.Plugin.Skills}}</dd>
          </div>
          {{end}}
        </dl>

        {{if .Plugin.Error}}<p class="mt-3 text-xs text-danger-ink">{{.Plugin.Error}}</p>{{end}}
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-2">
        {{if and .Plugin.Backend (ne .Plugin.Status "unused")}}
          {{if .Plugin.Enabled}}
          <form method="post" action="/extensions/{{.Plugin.ID}}/disable">
            {{template "csrf" .}}
            <button class="ada-btn ada-btn--secondary ada-btn--sm" type="submit">停用</button>
          </form>
          {{else}}
          <form method="post" action="/extensions/{{.Plugin.ID}}/enable">
            {{template "csrf" .}}
            <button class="ada-btn ada-btn--primary ada-btn--sm" type="submit">启用</button>
          </form>
          {{end}}
        {{end}}
        {{if .Plugin.FirstPage}}
        <a class="ada-btn ada-btn--secondary ada-btn--sm" href="/ext/{{.Plugin.ID}}/{{.Plugin.FirstPage}}">{{icon "i-external" 13}}打开插件页面</a>
        {{end}}
      </div>
    </div>
  </div>
{{template "shell_end" .}}{{end}}
