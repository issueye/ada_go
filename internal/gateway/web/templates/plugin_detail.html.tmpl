{{define "plugin_detail"}}{{template "doc_head" .}}{{template "shell_start" .}}
  <div class="ada-scroll">
    <div class="ada-wrap ada-wrap--page pd-page">
      {{template "flash" .}}
      {{/* 页头在岛外：插件级动作不随文件切换重渲染。标题拆成 名称 / ID / 版本 / 状态 / ⓘ，
           不再把三者挤成一个 h2（读屏与复制 ID 都更方便）。 */}}
      <header class="pd-head">
        <div class="pd-head__title">
          <h2 class="ada-page-title pd-head__name">{{.Plugin.Name}}</h2>
          <span class="pd-chip pd-chip--mono">{{.Plugin.ID}}</span>
          <span class="pd-chip pd-chip--mono">{{if .Plugin.Version}}v{{.Plugin.Version}}{{else}}—{{end}}</span>
          <span class="pd-state pd-state--{{.Plugin.StatusTone}}"><span class="pd-dot"></span>{{if .Plugin.Enabled}}已启用{{else}}{{if .Plugin.StatusLabel}}{{.Plugin.StatusLabel}}{{else}}未启用{{end}}{{end}}</span>
          <span class="pd-tip" data-tip="名称、版本与状态来自插件清单；包内文件只读展示，修改后需重载插件才会生效。" tabindex="0" role="img">i</span>
        </div>
        <div class="ada-section-head__actions pd-head__actions">
          {{if .Plugin.Enabled}}
          <form method="post" action="/extensions/{{.Plugin.ID}}/disable">
            {{template "csrf" .}}
            <input type="hidden" name="next" value="/extensions/{{.Plugin.ID}}">
            <button class="pd-btn" type="submit">停用</button>
          </form>
          {{else}}
          <form method="post" action="/extensions/{{.Plugin.ID}}/enable">
            {{template "csrf" .}}
            <input type="hidden" name="next" value="/extensions/{{.Plugin.ID}}">
            <button class="pd-btn pd-btn--primary" type="submit">启用</button>
          </form>
          {{end}}
          {{if .Plugin.FirstPage}}
          <a class="pd-btn" href="/ext/{{.Plugin.ID}}/{{.Plugin.FirstPage}}">打开插件页面</a>
          {{end}}
          <a class="pd-btn pd-btn--primary" href="/extensions">返回插件列表</a>
        </div>
      </header>

      {{/* SSR 与 islands.js 的详情岛用同一套 pd-* 类：hydrate 前后不重排。
           aria-label="插件信息" 保留给读屏与旧锚点，视觉上元数据已在首屏。 */}}
      <div id="plugin-detail-island" data-ada-island="plugin-detail" data-ada-state="{{.StateJSON}}">
      <div class="pd-root">
        <section class="pd-meta" aria-label="插件信息" id="plugin-info">
          <div class="pd-meta__row">
            <div class="pd-field">
              <span class="pd-field__label">状态</span>
              <span class="pd-field__value pd-field__value--{{.Plugin.StatusTone}}">{{if .Plugin.Enabled}}已启用{{else}}{{if .Plugin.StatusLabel}}{{.Plugin.StatusLabel}}{{else}}未启用{{end}}{{end}}</span>
            </div>
            <div class="pd-field">
              <span class="pd-field__label">归属</span>
              <span class="pd-field__value">{{if and .Plugin.Frontend .Plugin.Backend}}前端 + 后端{{else if .Plugin.Frontend}}前端插件{{else if .Plugin.Backend}}后端插件{{else}}—{{end}}</span>
            </div>
            <div class="pd-field">
              <span class="pd-field__label">信任级别</span>
              <span class="pd-field__value">{{if .Plugin.Trust}}{{.Plugin.Trust}}{{else}}—{{end}}</span>
            </div>
            <div class="pd-field">
              <span class="pd-field__label">来源</span>
              <span class="pd-field__value">{{if .Plugin.Source}}{{.Plugin.Source}}{{else}}随包{{end}}</span>
            </div>
            <div class="pd-field pd-field--grow">
              <span class="pd-field__label">能力</span>
              <span class="pd-caps">
                {{if .Plugin.Tools}}<span class="pd-cap">{{.Plugin.Tools}} 工具</span>{{end}}
                {{if .Plugin.Pages}}<span class="pd-cap">{{.Plugin.Pages}} 页面</span>{{end}}
                {{if .Plugin.Slots}}<span class="pd-cap">{{.Plugin.Slots}} 插槽</span>{{end}}
                {{if .Plugin.Hooks}}<span class="pd-cap">{{.Plugin.Hooks}} 钩子</span>{{end}}
                {{if .Plugin.Skills}}<span class="pd-cap">{{.Plugin.Skills}} 技能</span>{{end}}
                {{if .Plugin.Nav}}<span class="pd-cap">{{.Plugin.Nav}} 导航</span>{{end}}
                {{if .Plugin.HasDashboard}}<span class="pd-cap pd-cap--ok">dashboard</span>{{end}}
                {{if not (or .Plugin.Tools .Plugin.Pages .Plugin.Slots .Plugin.Hooks .Plugin.Skills .Plugin.Nav .Plugin.HasDashboard)}}<span class="pd-cap pd-cap--empty">—</span>{{end}}
              </span>
            </div>
          </div>
          <div class="pd-meta__path">
            <span class="pd-field__label">路径</span>
            <code class="pd-path">{{if .Plugin.Path}}{{.Plugin.Path}}{{else}}—{{end}}</code>
            <button type="button" class="pd-link" data-pd-copy="path">复制</button>
            {{if .Plugin.APIVersion}}<span class="pd-meta__api">API v{{.Plugin.APIVersion}}</span>{{end}}
          </div>
          {{if eq .Plugin.Status "unused"}}<p class="pd-note">当前产品没有默认启用这个插件；可在插件列表或本页手动启用。</p>{{end}}
          {{if and .Plugin.Description (ne .Plugin.Readme .Plugin.Description)}}<p class="pd-note">{{.Plugin.Description}}</p>{{end}}
          {{if .Plugin.Error}}<p class="pd-error">{{.Plugin.Error}}</p>{{end}}
        </section>

        <div class="pd-main">
          <aside class="pd-tree" aria-label="插件目录">
            <div class="pd-tree__head">
              <span class="pd-card__title">插件目录</span>
              <span class="pd-count">{{len .Plugin.Files}} 个文件</span>
            </div>
            {{if .Plugin.Files}}
            <ul class="pd-tree__list">
              {{range .Plugin.Files}}
              {{if .Dir}}
              <li class="pd-tree__row {{.DepthClass}}">
                <span class="pd-tree__item is-dir" title="{{.Path}}">
                  <span class="pd-tree__bar"></span><span class="pd-tree__bullet"></span>
                  <code class="pd-tree__name">{{.Path}}</code>
                </span>
              </li>
              {{else}}
              <li class="pd-tree__row {{.DepthClass}}">
                <a class="pd-tree__item{{if and $.File (eq .Path $.File.Path)}} is-active{{end}}"
                   href="/extensions/{{$.Plugin.ID}}?file={{urlquery .Path}}"
                   data-plugin-file-path="{{.Path}}" title="{{.Path}}">
                  <span class="pd-tree__bar"></span><span class="pd-tree__bullet"></span>
                  <code class="pd-tree__name">{{.Path}}</code>
                  <span class="pd-tree__size">{{.SizeLabel}}</span>
                </a>
              </li>
              {{end}}
              {{end}}
            </ul>
            {{else}}
            <p class="pd-tree__empty">这个插件没有可展示的包内文件。</p>
            {{end}}
            <p class="pd-tree__hint">点击文件查看内容；Markdown 可切换渲染 / 源码。</p>
          </aside>

          <section class="pd-doc" aria-label="文件内容">
            <div class="pd-doc__head">
              <code class="pd-doc__name">{{if .File}}{{.File.Path}}{{else}}README.md{{end}}</code>
              {{if .File}}<span class="pd-doc__size">{{.File.SizeLabel}}{{if .File.Truncated}} · 已截断{{end}}</span>{{end}}
              {{if .File}}{{if .File.Markdown}}
              <div class="pd-seg" role="group" aria-label="视图切换">
                <a class="pd-seg__item{{if .File.ShowPreview}} is-active{{end}}" rel="nofollow"
                   href="/extensions/{{.Plugin.ID}}?file={{urlquery .File.Path}}&amp;view=md"
                   title="切换到渲染预览">预览</a>
                <a class="pd-seg__item{{if not .File.ShowPreview}} is-active{{end}}" rel="nofollow"
                   href="/extensions/{{.Plugin.ID}}?file={{urlquery .File.Path}}"
                   title="切换到源码">源码</a>
              </div>
              {{end}}{{end}}
              <button type="button" class="pd-link pd-doc__copy" data-pd-copy="file">复制</button>
            </div>
            <div class="pd-doc__body">
              {{if .File}}
                {{if .File.Error}}
                <div class="pd-doc__fallback">
                  <p class="pd-doc__error-line">{{.File.Error}}</p>
                  {{if .Plugin.Readme}}
                  <span class="pd-doc__fallback-label">无法读取所选文件，以下为插件 README</span>
                  <div class="markdown-body ada-markdown pd-doc__preview">{{markdown .Plugin.Readme}}</div>
                  {{end}}
                </div>
                {{else if .File.Binary}}
                <p class="pd-doc__empty">这是二进制文件，暂不展示内容。</p>
                {{else if .File.ShowPreview}}
                <div class="markdown-body ada-markdown pd-doc__preview">{{.File.PreviewHTML}}</div>
                {{else}}
                <pre class="pd-doc__code chroma" data-plugin-file-content><code>{{.File.HTML}}</code></pre>
                {{end}}
              {{else if .Plugin.Readme}}
                <div class="markdown-body ada-markdown pd-doc__preview">{{markdown .Plugin.Readme}}</div>
              {{else}}
                <p class="pd-doc__empty">这个插件没有提供 README。</p>
              {{end}}
            </div>
            <div class="pd-doc__foot">
              <span>{{if .File}}{{.File.SizeLabel}} · {{if .File.Markdown}}Markdown{{else}}{{if .File.Language}}{{.File.Language}}{{else}}文本{{end}}{{end}} · {{if .File.ShowPreview}}渲染预览{{else}}源码{{end}}{{else}}README · 渲染预览{{end}}</span>
              <span>只读</span>
            </div>
          </section>
        </div>

        <div class="pd-foot">
          <div class="pd-foot__left">
            <span class="pd-tip pd-tip--sm" data-tip="第三方插件的入口与能力以插件清单为准；停用后不再贡献工具与页面。" tabindex="0" role="img">i</span>
            <span>第三方插件的入口与能力以插件清单为准；停用后不再贡献工具与页面。</span>
          </div>
          <span class="pd-foot__right">状态来自插件清单</span>
        </div>
      </div>
      </div>
    </div>
  </div>
{{template "shell_end" .}}{{end}}
