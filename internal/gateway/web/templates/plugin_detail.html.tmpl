{{define "plugin_detail"}}{{template "doc_head" .}}{{template "shell_start" .}}
  <div class="ada-scroll">
    <div class="ada-wrap ada-wrap--page">
      {{template "flash" .}}
      <div class="ada-section-head">
        {{/* 与其它二级页一致：顶栏 h1 是页面标识，正文标题用 h2（同 ada-page-title 字号），
             避免一篇页面出现两个 h1 让读屏的标题跳读重复。 */}}
        <h2 class="ada-page-title">
          {{.Plugin.Name}} {{.Plugin.ID}}{{if .Plugin.Version}} · v{{.Plugin.Version}}{{end}}
        </h2>
        {{/* 插件级动作放在页头：与「返回插件列表」同排，不随文件/信息面板滚动。 */}}
        <div class="ada-section-head__actions">
          {{if .Plugin.Enabled}}
          <form method="post" action="/extensions/{{.Plugin.ID}}/disable">
            {{template "csrf" .}}
            <input type="hidden" name="next" value="/extensions/{{.Plugin.ID}}">
            <button class="ada-btn ada-btn--secondary ada-btn--sm" type="submit">停用</button>
          </form>
          {{else}}
          <form method="post" action="/extensions/{{.Plugin.ID}}/enable">
            {{template "csrf" .}}
            <input type="hidden" name="next" value="/extensions/{{.Plugin.ID}}">
            <button class="ada-btn ada-btn--primary ada-btn--sm" type="submit">启用</button>
          </form>
          {{end}}
          {{if .Plugin.FirstPage}}
          <a class="ada-btn ada-btn--secondary ada-btn--sm" href="/ext/{{.Plugin.ID}}/{{.Plugin.FirstPage}}">{{icon "i-external" 13}}打开插件页面</a>
          {{end}}
          <a class="ada-btn ada-btn--secondary ada-btn--sm" href="/extensions">返回插件列表</a>
        </div>
      </div>

      <div id="plugin-detail-island" data-ada-island="plugin-detail" data-ada-state="{{.StateJSON}}">
      <div class="ada-plugin-detail">
        <aside class="ada-plugin-detail__side">
          <section class="ada-panel ada-plugin-tree-card" aria-label="插件目录">
            <div class="ada-plugin-tree-card__head">
              <h2 class="ada-plugin-section__title">插件目录 <span class="ada-plugin-section__meta">{{len .Plugin.Files}} 个文件</span></h2>
            </div>
            {{if .Plugin.Files}}
            <ul class="ada-plugin-tree">
              {{range .Plugin.Files}}
              {{if .Dir}}
              <li class="ada-plugin-tree__row {{.DepthClass}}">
                <span class="ada-plugin-tree__item is-dir">
                  <span class="ada-plugin-tree__icon">{{icon "i-folder" 13}}</span>
                  <code class="ada-plugin-tree__path">{{.Path}}</code>
                </span>
              </li>
              {{else}}
              <li class="ada-plugin-tree__row {{.DepthClass}}">
                <a class="ada-plugin-tree__item{{if and $.File (eq .Path $.File.Path)}} is-active{{end}}"
                   href="/extensions/{{$.Plugin.ID}}?file={{urlquery .Path}}"
                   data-plugin-file-path="{{.Path}}" title="{{.Path}}">
                  <span class="ada-plugin-tree__icon">{{icon "i-file" 13}}</span>
                  <code class="ada-plugin-tree__path">{{.Path}}</code>
                  <span class="ada-plugin-tree__size">{{.SizeLabel}}</span>
                </a>
              </li>
              {{end}}
              {{end}}
            </ul>
            {{else}}
            <p class="ada-plugin-tree__empty">这个插件没有可展示的包内文件。</p>
            {{end}}
            <a class="ada-plugin-tree-card__info" href="#plugin-info">插件信息</a>
          </section>
        </aside>

        <div class="ada-plugin-detail__main">
          <section class="ada-panel ada-plugin-viewer" aria-label="文件内容">
            {{if .File}}
            <header class="ada-plugin-viewer__head">
              <code class="ada-plugin-viewer__path">{{.File.Path}}</code>
              <div class="ada-plugin-viewer__actions">
                <span class="ada-plugin-viewer__meta">{{.File.SizeLabel}}{{if .File.Truncated}} · 已截断{{end}}</span>
                {{if .File.Markdown}}
                {{/* 无 JS 时的开关：换一个 URL 重新渲染（?view=md）；有 JS 时由岛屿接管同一个按钮。 */}}
                <a class="ada-plugin-viewer__toggle" rel="nofollow"
                   href="/extensions/{{.Plugin.ID}}?file={{urlquery .File.Path}}{{if not .File.ShowPreview}}&amp;view=md{{end}}"
                   title="{{if .File.ShowPreview}}切换到源码{{else}}切换到渲染预览{{end}}">{{if .File.ShowPreview}}源码{{else}}预览{{end}}</a>
                {{end}}
              </div>
            </header>
            {{if .File.Error}}
            <p class="ada-plugin-viewer__empty">{{.File.Error}}</p>
            {{else if .File.Binary}}
            <p class="ada-plugin-viewer__empty">这是二进制文件，暂不展示内容。</p>
            {{else if .File.ShowPreview}}
            <div class="markdown-body ada-markdown ada-plugin-file-preview">{{.File.PreviewHTML}}</div>
            {{else}}
            <pre class="ada-plugin-viewer__code chroma" data-plugin-file-content><code>{{.File.HTML}}</code></pre>
            {{end}}
            {{else}}
            <p class="ada-plugin-viewer__empty">这个插件没有可展示的包内文件。</p>
            {{end}}
          </section>

          <section id="plugin-info" class="ada-panel p-4 ada-plugin-panel" data-plugin-panel="info">
            <div class="flex flex-wrap items-center gap-2">
              {{if .Plugin.Frontend}}<span class="ada-chip ada-chip--brand">前端插件</span>{{end}}
              {{if .Plugin.Backend}}<span class="ada-chip">后端插件</span>{{end}}
              <span class="ada-chip ada-chip--{{.Plugin.StatusTone}}">{{.Plugin.StatusLabel}}</span>
              {{if .Plugin.Status}}<span class="ada-chip ada-chip--mono">{{.Plugin.Status}}</span>{{end}}
            </div>

            {{if eq .Plugin.Status "unused"}}<p class="mt-2 text-xs text-muted">当前产品没有默认启用这个插件；可在插件列表或本页手动启用。</p>{{end}}
            {{if and .Plugin.Description (ne .Plugin.Readme .Plugin.Description)}}<p class="mt-2 text-sm leading-6 text-muted">{{.Plugin.Description}}</p>{{end}}

            <div class="ada-plugin-stats">
              <div class="ada-plugin-stat">
                <span class="ada-plugin-stat__value">{{.Plugin.Pages}}</span>
                <span class="ada-plugin-stat__label">页面</span>
              </div>
              <div class="ada-plugin-stat">
                <span class="ada-plugin-stat__value">{{.Plugin.Tools}}</span>
                <span class="ada-plugin-stat__label">工具</span>
              </div>
              <div class="ada-plugin-stat">
                <span class="ada-plugin-stat__value">{{.Plugin.Slots}}</span>
                <span class="ada-plugin-stat__label">插槽</span>
              </div>
            </div>

            <dl class="ada-plugin-meta">
              <div>
                <dt>版本</dt>
                <dd>{{if .Plugin.Version}}v{{.Plugin.Version}}{{else}}—{{end}}</dd>
              </div>
              <div>
                <dt>API 版本</dt>
                <dd>{{if .Plugin.APIVersion}}{{.Plugin.APIVersion}}{{else}}—{{end}}</dd>
              </div>
              <div>
                <dt>信任级别</dt>
                <dd>{{if .Plugin.Trust}}{{.Plugin.Trust}}{{else}}—{{end}}</dd>
              </div>
              <div>
                <dt>来源</dt>
                <dd>{{if .Plugin.Source}}{{.Plugin.Source}}{{else}}随包{{end}}</dd>
              </div>
              <div class="ada-plugin-meta__wide">
                <dt>插件路径</dt>
                <dd class="ada-plugin-meta__mono">{{if .Plugin.Path}}{{.Plugin.Path}}{{else}}—{{end}}</dd>
              </div>
              {{if .Plugin.Hooks}}<div><dt>钩子</dt><dd>{{.Plugin.Hooks}}</dd></div>{{end}}
              {{if .Plugin.Skills}}<div><dt>技能</dt><dd>{{.Plugin.Skills}}</dd></div>{{end}}
              {{if .Plugin.Nav}}<div><dt>导航</dt><dd>{{.Plugin.Nav}}</dd></div>{{end}}
              <div class="ada-plugin-meta__wide">
                <dt>插件 ID</dt>
                <dd class="ada-plugin-meta__mono">{{.Plugin.ID}}</dd>
              </div>
            </dl>

            <div class="ada-plugin-section">
              <h2 class="ada-plugin-section__title">README</h2>
              {{if .Plugin.Readme}}
              <div class="markdown-body ada-markdown ada-plugin-readme">{{markdown .Plugin.Readme}}</div>
              {{else}}
              <p class="text-sm text-muted">这个插件没有提供 README。</p>
              {{end}}
            </div>

            {{if .Plugin.Error}}<p class="mt-3 text-xs text-danger-ink">{{.Plugin.Error}}</p>{{end}}
          </section>
        </div>
      </div>
      </div>
    </div>
  </div>
{{template "shell_end" .}}{{end}}
