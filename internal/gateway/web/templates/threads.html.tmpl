{{define "threads"}}{{template "head" .}}
<div class="ada-scroll">
<div class="ada-wrap">
<div class="page">
{{if .IsHome}}
<section class="panel create-panel">
  <h1>新会话</h1>
  <form method="post" action="/threads" class="create-form">
    {{template "csrf" .}}
    <label class="field">标题
      <input type="text" name="title" maxlength="200" placeholder="留空显示为「新会话」">
    </label>
    <button type="submit" class="btn-primary">开始会话</button>
  </form>
</section>
{{else}}
<h1>全部会话</h1>
{{end}}

<section class="panel">
  <div class="panel-head">
    <h2>最近会话</h2>
    <span class="muted">工作区：{{.Workspace}}</span>
  </div>
  {{if .Threads}}
  <ul class="thread-list">
    {{range .Threads}}
    <li class="thread-row">
      <a class="thread-link" href="/thread/{{.ID}}">{{if .Title}}{{.Title}}{{else}}新会话{{end}}</a>
      <span class="thread-meta">{{.UpdatedAt}}{{if .Archived}} · 已归档{{end}}</span>
    </li>
    {{end}}
  </ul>
  {{if .HasMore}}<p class="pager"><a href="/threads?limit={{.Limit}}&amp;cursor={{urlquery .NextCursor}}">下一页</a></p>{{end}}
  {{else}}
  <div class="empty-state">
    <p>还没有会话。创建一个，然后在这里看到它。</p>
  </div>
  {{end}}
</section>
</div>
</div>
</div>
{{template "foot" .}}{{end}}
