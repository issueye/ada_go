{{define "offline"}}{{template "doc_head" .}}{{template "shell_start" .}}
  <div class="ada-scroll">
    <div class="ada-wrap ada-wrap--page">
      {{template "flash" .}}
      <div class="ada-empty">
        <span class="ada-empty__mark">{{icon "i-alert" 20}}</span>
        <h2 class="ada-empty__title">未连接</h2>
        <p class="ada-empty__desc">{{.Reason}}</p>
        <p class="ada-empty__desc">请确认桌面端或网关仍在运行，然后重新连接。已加载的页面不会伪造数据。</p>
        <div class="ada-empty__action">
          <a class="ada-btn ada-btn--primary ada-btn--sm" href="">重新连接</a>
          <a class="ada-btn ada-btn--secondary ada-btn--sm" href="/">返回会话</a>
        </div>
      </div>
    </div>
  </div>
{{template "shell_end" .}}{{end}}
