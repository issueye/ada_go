{{define "extensions"}}{{template "doc_head" .}}{{template "shell_start" .}}
  <div class="ada-scroll">
  <div class="ada-wrap ada-wrap--page">
    {{template "flash" .}}
    <div class="ex-head">
      <div class="ex-head__title">
        <h2 class="ada-page-title">插件</h2>
        <span class="ex-count">{{.PluginCount}}</span>
        <span class="ex-tip" data-tip="列表合并了两侧来源的扩展；停用后不再贡献工具与页面，重载插件后生效。状态来自插件清单。" tabindex="0" role="img">!</span>
      </div>
      <form method="post" action="/agent-plugins/reload">
        {{template "csrf" .}}
        <input type="hidden" name="next" value="/extensions">
        <button class="ex-btn ex-btn--primary" type="submit">{{icon "i-refresh" 13}}重载插件</button>
      </form>
    </div>

    <div id="extensions-island" class="ex-island" data-ada-island="extensions" data-ada-state="{{.StateJSON}}">
      <div class="ex-toolbar">
        <label class="ex-search">
          <input class="ex-search__input" type="text" placeholder="搜索插件名 / ID" aria-label="搜索插件">
          <span class="ex-search__kbd">⌘K</span>
        </label>
        <div class="ex-seg" role="group" aria-label="按状态筛选">
          <button class="ex-seg__item is-active" type="button" aria-pressed="true">全部 {{.PluginCount}}</button>
          <button class="ex-seg__item" type="button" aria-pressed="false">已启用 {{.EnabledCount}}</button>
          <button class="ex-seg__item" type="button" aria-pressed="false">未启用 {{.DisabledCount}}</button>
        </div>
        <span class="ex-toolbar__meta">{{.PluginCount}} 个已安装</span>
      </div>
      {{template "extensions_partial" .}}
    </div>
    {{slot "extensions.list" .Slots.ExtensionsList .SlotCounts.ExtensionsList ""}}
    <div class="ex-foot">
      <span class="ex-foot__left"><span class="ex-tip ex-tip--sm" data-tip="启停会写回工作区配置；前端扩展在装配期固定，重载网关后新配置才会生效。" tabindex="0" role="img">!</span>停用后插件不再贡献工具与页面；重载插件后生效</span>
      <span class="ex-foot__right">状态来自插件清单</span>
    </div>
  </div>
  </div>
{{template "shell_end" .}}{{end}}

{{define "extensions_partial"}}
{{if .Plugins}}
<div class="ex-list">
  <div class="ex-row ex-row--head">
    <span>插件</span><span>版本</span><span>状态</span><span>能力</span><span>操作</span>
  </div>
  {{range .Plugins}}
  <div class="ex-row" data-enabled="{{.Enabled}}">
    <div class="ex-row__main">
      <a class="ex-row__name" href="/extensions/{{.ID}}">{{if .Name}}{{.Name}}{{else}}{{.ID}}{{end}}</a>
      <span class="ex-row__id">{{.ID}}</span>
      {{if .Error}}<span class="ex-row__error">{{.Error}}</span>{{end}}
    </div>
    <span class="ex-row__version">{{if .Version}}v{{.Version}}{{else}}—{{end}}</span>
    <span class="ex-row__status" data-tone="{{.StatusTone}}"><span class="ex-dot"></span>{{.StatusLabel}}</span>
    <div class="ex-row__caps">
      {{if .Tools}}<span class="ex-chip">{{.Tools}} 工具</span>{{end}}
      {{if .Pages}}<span class="ex-chip">{{.Pages}} 页面</span>{{end}}
      {{if .Slots}}<span class="ex-chip">{{.Slots}} 插槽</span>{{end}}
      {{if .HasDashboard}}<span class="ex-chip ex-chip--ok">dashboard</span>{{end}}
      {{if and (not .Tools) (not .Pages) (not .Slots) (not .HasDashboard)}}<span class="ex-row__dash">—</span>{{end}}
    </div>
    <div class="ex-row__actions">
      {{if .Enabled}}
      <form method="post" action="/extensions/{{.ID}}/disable">
        {{template "csrf" $}}
        <input type="hidden" name="next" value="/extensions">
        <button class="ex-action" type="submit">停用</button>
      </form>
      {{else}}
      <form method="post" action="/extensions/{{.ID}}/enable">
        {{template "csrf" $}}
        <input type="hidden" name="next" value="/extensions">
        <button class="ex-action ex-action--primary" type="submit">启用</button>
      </form>
      {{end}}
      <a class="ex-link" href="/extensions/{{.ID}}">详情</a>
    </div>
  </div>
  {{end}}
</div>
{{else}}
<div class="ex-empty">
  <p class="ex-empty__title">没有插件</p>
  <p class="ex-empty__desc">插件可能尚未装配，或网关暂时不可用。查看服务端日志确认。</p>
</div>
{{end}}
{{end}}
