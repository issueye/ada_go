{{define "ext"}}{{template "head" .}}
<div class="ada-corner-dock" id="chat-corner" aria-hidden="true"></div>
<div class="ada-chat-viewport">
  <div class="ada-scroll" id="chat-scroll">
    <div class="ada-wrap">
      <div class="page ext-page" data-ext-plugin="{{.PluginID}}" data-ext-slug="{{.Slug}}">
        <header class="thread-head">
          <div>
            <h1>{{.Title}}</h1>
            <p class="muted">扩展页面 · {{.PluginID}}/{{.Slug}}</p>
          </div>
        </header>
        <section class="ext-content" id="ext-content">
{{.Content}}
        </section>
        {{slot "extensions.list" .Slots.ExtensionsList .SlotCounts.ExtensionsList ""}}
        {{slot "dashboard.widgets" .Slots.DashboardWidgets .SlotCounts.DashboardWidgets ""}}
      </div>
    </div>
  </div>
</div>
{{template "foot" .}}{{end}}
