{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "设计画布台账",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "total"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "subtitle": { "type": "string", "maxLength": 120 },
    "total": { "type": "number", "minimum": 0, "maximum": 100000 },
    "canvasUrl": { "type": "string", "maxLength": 200 },
    "groups": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 40 },
          "value": { "type": "number", "minimum": 0, "maximum": 100000 },
          "note": { "type": "string", "maxLength": 80 }
        }
      }
    },
    "nodes": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "system": { "type": "string", "maxLength": 40 },
          "artboard": { "type": "string", "maxLength": 40 },
          "size": { "type": "string", "maxLength": 24 }
        }
      }
    }
  }
}
