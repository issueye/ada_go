{
  "id": "ui-todo",
  "name": "Todo 列表",
  "version": "0.1.0",
  "apiVersion": 1,
  "description": "把 tools-plan 的当前计划渲染成会话区右上角的 Todo 卡片；没有计划时不占位，不使用示例数据。",
  "trust": "builtin",
  "frontend": {
    "capabilities": ["backend.read"],
    "slots": [{ "slot": "chat.corner", "template": "slot.tsx", "order": 10 }],
    "styles": ["todo.css"],
    "assets": "static",
    "actions": {
      "slot_chat_corner": { "action": "plan", "read": true, "backend": "tools-plan" }
    }
  }
}
