{
  "id": "cron-manager",
  "name": "定时任务",
  "version": "0.2.0",
  "apiVersion": 1,
  "description": "管理定时任务（AI 任务）：任务存 global.config 的 cron 命名空间，插件用通用定时器解析 cron 并调用 turn.invoke 触发轮次；基座不读 cron.json、不调度、不暴露 cron 端点。",
  "trust": "builtin",
  "backend": {
    "entry": "index.ts",
    "capabilities": ["fs.read", "global.config", "turn.invoke"],
    "configNamespace": "cron"
  },
  "frontend": {
    "capabilities": ["frontend.script"],
    "nav": [{ "label": "定时任务", "slug": "cron" }],
    "pages": [{ "slug": "cron", "title": "定时任务", "template": "page.tsx" }],
    "scripts": ["cron-manager.js"],
    "styles": ["cron-manager.css"],
    "assets": "static"
  }
}
