{
  "id": "provider-admin",
  "name": "供应商管理",
  "version": "0.4.0",
  "apiVersion": 1,
  "description": "模型设置：集中管理供应商（端点/API 格式/密钥/模型清单）与当前模型；数据经插件 route 读写，密钥不经过浏览器。",
  "trust": "builtin",
  "backend": {
    "entry": "index.ts",
    "capabilities": [
      "model.admin",
      "global.config",
      "net.fetch"
    ],
    "configNamespace": "provider-config"
  },
  "frontend": {
    "capabilities": [
      "frontend.script",
      "backend.read"
    ],
    "slots": [
      { "slot": "composer.left", "component": "ProviderChip.vue", "order": 10 }
    ],
    "nav": [
      { "slug": "providers", "label": "供应商" }
    ],
    "pages": [
      { "slug": "providers", "component": "Providers.vue", "title": "供应商" }
    ],
    "actions": {
      "page_providers": {
        "action": "state",
        "read": true,
        "backend": "provider-admin"
      }
    },
    "styles": [
      "provider-admin.css"
    ],
    "assets": "static"
  }
}
