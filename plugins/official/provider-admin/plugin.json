{
  "id": "provider-admin",
  "name": "供应商管理",
  "version": "0.2.0",
  "apiVersion": 1,
  "description": "供应商与模型管理：后端 route 提供目录与切换当前模型，页面经 /ext/provider-admin/api/* 调用；密钥与端点只来自配置，不在页面回显。",
  "trust": "builtin",
  "backend": {
    "entry": "index.ts",
    "capabilities": ["model.admin"]
  },
  "frontend": {
    "capabilities": ["backend.read", "frontend.script"],
    "nav": [{ "label": "供应商", "slug": "providers" }],
    "pages": [{ "slug": "providers", "title": "供应商", "template": "page.tsx" }],
    "scripts": ["provider-admin.js"],
    "styles": ["provider-admin.css"],
    "assets": "static"
  }
}
