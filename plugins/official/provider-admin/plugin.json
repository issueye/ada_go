{
  "id": "provider-admin",
  "name": "供应商管理",
  "version": "0.3.1",
  "apiVersion": 1,
  "description": "模型设置：集中管理供应商（端点/API 格式/密钥/模型清单）与当前模型；数据经插件 route 读写，密钥不经过浏览器。",
  "trust": "builtin",
  "backend": {
    "entry": "index.ts",
    "capabilities": ["model.admin"]
  },
  "frontend": {
    "capabilities": ["frontend.script"],
    "client": "client.js",
    "slots": [{ "slot": "composer.left", "template": "slot.tsx", "order": 10 }],
    "nav": [{ "label": "供应商", "slug": "providers" }],
    "pages": [
      { "slug": "providers", "title": "供应商", "template": "page.tsx", "hydrate": true },
      { "slug": "providers-next", "title": "供应商（组件化原型）", "template": "providers-next.tsx", "hydrate": true }
    ],
    "scripts": ["provider-admin.js"],
    "styles": ["provider-admin.css"],
    "assets": "static"
  }
}
