{
  "id": "ui-hello-tsx",
  "name": "Hello TSX",
  "version": "0.1.0",
  "apiVersion": 1,
  "description": "M4 前端插件最小示例：一个由 TSX 服务端渲染的 /ext 页面，外加一个 P1-7 同构岛屿试点",
  "trust": "builtin",
  "frontend": {
    "capabilities": ["frontend.script"],
    "client": "client.js",
    "pages": [
      { "slug": "hello", "template": "hello.tsx", "title": "Hello TSX" },
      { "slug": "counter", "template": "counter.tsx", "title": "Island Counter", "hydrate": true }
    ],
    "assets": "static"
  }
}
