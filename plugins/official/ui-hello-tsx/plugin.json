{
  "id": "ui-hello-tsx",
  "name": "Hello TSX",
  "version": "0.1.0",
  "apiVersion": 1,
  "description": "前端插件最小示例：纯 SSR 页面、同构页面岛屿与插槽岛屿",
  "trust": "builtin",
  "frontend": {
    "capabilities": ["frontend.script"],
    "client": "client.js",
    "slots": [
      { "slot": "sidebar.top", "template": "slot.tsx", "hydrate": true, "order": 90 }
    ],
    "pages": [
      { "slug": "hello", "template": "hello.tsx", "title": "Hello TSX" },
      { "slug": "counter", "template": "counter.tsx", "title": "Island Counter", "hydrate": true }
    ],
    "assets": "static"
  }
}
