{
  "id": "ui-ask-user",
  "name": "提问卡片",
  "version": "0.1.0",
  "apiVersion": 1,
  "description": "在交互托盘（thread.tray）里渲染当前线程的待答项（审批/选择/输入），表单提交回基座交互路由；无待答项时不占位。",
  "trust": "builtin",
  "frontend": {
    "capabilities": ["backend.read"],
    "slots": [{ "slot": "thread.tray", "template": "slot.tsx", "order": 10 }],
    "styles": ["ask-user.css"],
    "assets": "static"
  }
}
