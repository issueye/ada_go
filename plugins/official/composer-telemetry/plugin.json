{
  "id": "composer-telemetry",
  "name": "Composer 遥测",
  "version": "0.1.0",
  "apiVersion": 1,
  "description": "输入框下方辅助区（运行中 / 工作区 / 缓存命中 / 上下文占用）：运行/上下文读会话通用投影，token/缓存/成本由插件用 events.read 聚合。",
  "trust": "builtin",
  "backend": {
    "entry": "index.ts",
    "capabilities": ["events.read"]
  },
  "frontend": {
    "capabilities": ["frontend.script"],
    "client": "client.js",
    "slots": [
      {
        "slot": "composer.footer",
        "template": "composer-footer.tsx",
        "hydrate": true,
        "clientOnly": true,
        "order": 10
      }
    ],
    "styles": ["telemetry.css"],
    "assets": "static"
  }
}
