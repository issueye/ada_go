{
  "id": "mcp-client",
  "name": "MCP 客户端",
  "version": "0.1.0",
  "apiVersion": 1,
  "description": "把 MCP server 的工具接入为普通工具（HTTP/stdio；配置工作区 .adag/mcp.json）",
  "trust": "builtin",
  "backend": {
    "entry": "index.ts",
    "capabilities": ["fs.read", "net.fetch", "process"],
    "env": ["PATH", "HOME", "USERPROFILE", "SystemRoot"],
    "secrets": ["mcp_token"],
    "initTimeoutMs": 30000
  }
}
