{
  "id": "mcp-client",
  "name": "MCP 客户端",
  "version": "0.4.0",
  "apiVersion": 1,
  "description": "把 MCP server 的工具接入为普通工具（HTTP/stdio；配置工作区 .adago/mcp.json），并提供 MCP 服务端管理页",
  "trust": "builtin",
  "backend": {
    "entry": "index.ts",
    "capabilities": ["fs.read", "fs.write", "net.fetch", "process"],
    "env": ["PATH", "HOME", "USERPROFILE", "SystemRoot", "APPDATA", "LOCALAPPDATA", "XDG_CONFIG_HOME"],
    "secrets": ["mcp_token"],
    "initTimeoutMs": 30000
  },
  "frontend": {
    "capabilities": ["frontend.script"],
    "nav": [{ "label": "MCP 服务端", "slug": "servers" }],
    "pages": [{ "slug": "servers", "title": "MCP 服务端", "template": "page.tsx" }],
    "scripts": ["mcp-client.js"],
    "styles": ["mcp-client.css"],
    "assets": "static"
  }
}

