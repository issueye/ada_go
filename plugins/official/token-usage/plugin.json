{
  "id": "token-usage",
  "name": "Token 用量",
  "version": "0.3.0",
  "apiVersion": 1,
  "description": "按工作区与当前会话展示 token 用量（输入/输出/缓存）与成本；插件用 events.read 读取每轮原始计数并自行聚合。",
  "trust": "builtin",
  "backend": {
    "entry": "index.ts",
    "capabilities": [
      "events.read"
    ]
  },
  "frontend": {
    "capabilities": [
      "backend.read",
      "frontend.script"
    ],
    "nav": [
      { "slug": "usage", "label": "Token 用量" }
    ],
    "pages": [
      { "slug": "usage", "component": "UsagePage.vue", "title": "Token 用量" }
    ],
    "dashboard": [
      { "component": "UsageWidget.vue", "order": 10 }
    ],
    "actions": {
      "page_usage": {
        "action": "usage",
        "read": true,
        "backend": "token-usage"
      }
    },
    "blocks": [
      {
        "name": "usage-card",
        "title": "Token 用量卡片",
        "description": "在 Markdown 中内联展示一次 token 用量摘要",
        "schema": "schemas/usage-card.json",
        "template": "blocks/usage-card.tsx",
        "profile": "display"
      }
    ],
    "styles": [
      "usage.css"
    ],
    "assets": "static"
  }
}
