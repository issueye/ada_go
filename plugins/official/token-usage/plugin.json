{
  "id": "token-usage",
  "name": "Token 用量",
  "version": "0.2.0",
  "apiVersion": 1,
  "description": "按工作区与当前会话展示 token 用量（输入/输出/缓存）与成本；数据来自 Core usage.get。",
  "trust": "builtin",
  "frontend": {
    "capabilities": ["backend.read", "frontend.script"],
    "client": "client.js",
    "nav": [{ "label": "Token 用量", "slug": "usage" }],
    "pages": [{ "slug": "usage", "title": "Token 用量", "template": "page.tsx", "hydrate": true }],
    "blocks": [{
      "name": "usage-card",
      "title": "Token 用量卡片",
      "description": "在 Markdown 中内联展示一次 token 用量摘要",
      "schema": "schemas/usage-card.json",
      "template": "blocks/usage-card.tsx",
      "profile": "display"
    }],
    "dashboard": [{ "widget": "usage", "template": "dashboard.tsx", "order": 10 }],
    "styles": ["usage.css"],
    "assets": "static"
  }
}
