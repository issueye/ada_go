{
  "id": "env-manager",
  "name": "环境变量",
  "version": "0.2.0",
  "apiVersion": 1,
  "description": "管理全局与工作区环境变量（注入插件启动的子进程；变量存 global.config 的 env 命名空间）；服务程序目录由插件用 ctx.fs 投影。",
  "trust": "builtin",
  "backend": {
    "entry": "index.ts",
    "capabilities": [
      "fs.read",
      "global.config"
    ],
    "configNamespace": "env"
  },
  "frontend": {
    "capabilities": [
      "frontend.script",
      "backend.read"
    ],
    "nav": [
      { "slug": "settings", "label": "环境变量" }
    ],
    "pages": [
      { "slug": "settings", "component": "EnvSettings.vue", "title": "环境变量" }
    ],
    "actions": {
      "page_settings": {
        "action": "state",
        "read": true,
        "backend": "env-manager"
      }
    },
    "styles": [
      "env-manager.css"
    ],
    "assets": "static"
  }
}
