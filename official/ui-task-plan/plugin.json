{
  "id": "ui-task-plan",
  "name": "任务卡片",
  "version": "0.1.0",
  "apiVersion": 1,
  "description": "把只读动作返回的任务计划渲染成交互托盘里的插件卡（DOM/class 同 a_da task-plan）",
  "trust": "builtin",
  "frontend": {
    "capabilities": ["backend.read"],
    "slots": [{ "slot": "thread.tray", "template": "slot.tsx", "order": 10 }],
    "styles": ["task-plan.css"],
    "assets": "static",
    "actions": {
      "slot_thread_tray": { "action": "plan", "read": true, "backend": "tools-plan" }
    }
  }
}
