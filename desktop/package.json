{
  "name": "ada-go-desktop",
  "version": "1.0.0-rc.1",
  "author": "ada-go",
  "private": true,
  "description": "ada-go desktop shell: Electron host that supervises `adag gateway` and loads the SSR UI",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win dir",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "electron-winstaller@5.4.0": true
  }
}
