{
  "id": "headless",
  "name": "ada-go Headless",
  "description": "M1 无头内核的可运行产品：OpenAI Chat provider + 文件/命令/计划/提问工具 + 默认审批策略，以及 Todo/提问/供应商/Token 用量四个官方前端插件。",
  "plugins": [
    "provider-openai-chat",
    "tools-fs",
    "tools-shell",
    "tools-plan",
    "tools-ask",
    "policy-default",
    "ui-todo",
    "ui-ask-user",
    "provider-admin",
    "token-usage"
  ],
  "capabilities": {
    "skills": false,
    "images": true,
    "subagents": false
  },
  "identity": {
    "name": "ada-go",
    "locale": "zh-CN"
  },
  "policies": {
    "toolTimeoutMs": 120000,
    "turnTimeoutMs": 0,
    "maxTurnTokens": 0,
    "loopRepeatLimit": 3,
    "loopAbortLimit": 5,
    "parallelTools": 1
  }
}
