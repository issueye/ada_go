{
  "id": "headless",
  "name": "ada-go Headless",
  "description": "M1 无头内核的可运行产品：OpenAI Chat provider + 文件/命令/计划/提问工具（计划与提问的卡片随各自的工具插件一起提供）+ 默认审批策略 + 随包技能（提示注入绝对路径，模型用 read_file 读取），以及供应商管理/Token 用量/插件助手三个独立前端插件。",
  "plugins": [
    "provider-openai-chat",
    "tools-fs",
    "tools-shell",
    "tools-plan",
    "tools-ask",
    "tools-skill",
    "policy-default",
    "provider-admin",
    "token-usage",
    "ui-charts",
    "plugin-helper",
    "env-manager"
  ],
  "capabilities": {
    "skills": true,
    "images": true,
    "subagents": false,
    "markdownBlocks": true
  },
  "identity": {
    "name": "ada-go",
    "locale": "zh-CN"
  },
  "policies": {
    "toolTimeoutMs": 120000,
    "turnTimeoutMs": 0,
    "maxTurnTokens": 0,
    "loopRepeatLimit": 3,
    "loopAbortLimit": 5,
    "parallelTools": 1
  }
}

